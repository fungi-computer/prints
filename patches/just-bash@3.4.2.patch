diff --git a/dist/bundle/browser-compression.js b/dist/bundle/browser-compression.js
new file mode 100644
index 0000000000000000000000000000000000000000..db6a6a6d6bb71955b7135a81b77bc50edb35dc8a
--- /dev/null
+++ b/dist/bundle/browser-compression.js
@@ -0,0 +1,43 @@
+import { Deflate, Inflate } from "pako";
+
+// Match the caller's already-reserved output budget while the maintained
+// decoder is running, not after it has materialized an unbounded result.
+function collectWithinLimit(codec, input, maxOutputBytes) {
+  let size = 0;
+  const collect = codec.onData;
+  codec.onData = function (chunk) {
+    if (chunk.byteLength > maxOutputBytes - size) {
+      throw new Error(`gzip output exceeds limit (${maxOutputBytes} bytes)`);
+    }
+    size += chunk.byteLength;
+    collect.call(this, chunk);
+  };
+  if (!codec.push(input, true) || codec.err || codec.result === undefined) {
+    throw new Error(codec.msg || "Invalid or incomplete gzip stream");
+  }
+  return codec.result;
+}
+
+function chunkSize(maxOutputBytes) {
+  if (!Number.isSafeInteger(maxOutputBytes) || maxOutputBytes <= 0) {
+    throw new Error("gzip output limit must be a positive safe integer");
+  }
+  // At most one bounded chunk can cross the remaining output allowance.
+  return Math.min(maxOutputBytes, 65536);
+}
+
+export function decompressGzip(input, maxOutputBytes) {
+  return collectWithinLimit(
+    new Inflate({ windowBits: 31, chunkSize: chunkSize(maxOutputBytes) }),
+    input,
+    maxOutputBytes,
+  );
+}
+
+export function compressGzip(input, maxOutputBytes, level) {
+  return collectWithinLimit(
+    new Deflate({ gzip: true, level, chunkSize: chunkSize(maxOutputBytes) }),
+    input,
+    maxOutputBytes,
+  );
+}
